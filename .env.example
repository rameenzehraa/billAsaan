MODEL_PROVIDER=google
MODEL_NAME=gemini-3.5-flash-lite
API_KEY=your-api-key-here

# Optional: use only after confirming IPv6 TLS fails while IPv4 works.
GENAI_IPV4_ONLY=0

# Public demo (D3). FREE_TIER=true requires a consent tick before upload (Gemini free tier may use content).
FREE_TIER=true
MAX_BILLS_PER_SESSION=3
MAX_QUESTIONS_PER_BILL=15
# Whole-server daily caps; reset at midnight Asia/Karachi and whenever the app restarts.
DAILY_EXTRACTION_CAP=150
DAILY_CHAT_CAP=400
