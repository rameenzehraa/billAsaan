# Copy to .streamlit/secrets.toml (gitignored) for local use, or paste into the Streamlit Cloud "Secrets" box.
# Placeholders only: never commit real values.

API_KEY = "your-gemini-api-key"
MODEL_NAME = "gemini-3.5-flash-lite"

# true: consent notice (Gemini free tier may use uploaded content). false: paid tier, in-memory note only.
FREE_TIER = true

MAX_BILLS_PER_SESSION = 3
MAX_QUESTIONS_PER_BILL = 15
# Whole-app daily caps; reset at midnight Asia/Karachi and whenever the app restarts.
DAILY_EXTRACTION_CAP = 150
DAILY_CHAT_CAP = 400
